datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Papel {
  ALUNO
  PROFESSOR
}

enum TipoTrabalho {
  INDIVIDUAL
  EQUIPE
}

enum DonoTipo {
  ALUNO
  EQUIPE
}

enum StatsStatus {
  PENDENTE
  CALCULADO
  ERRO
}

enum RepoSetupStatus {
  PENDENTE
  CONFIGURADO
  ERRO
}

enum SinalizacaoTipo {
  DIVERGENCIA_PUSHER_AUTOR
  SEM_ATIVIDADE
  FORCE_PUSH
  COMMIT_GIGANTE
  AUTOR_NAO_RECONHECIDO
}

enum SinalizacaoIntensidade {
  BAIXA
  MEDIA
  ALTA
}

enum SinalizacaoStatus {
  PENDENTE
  PROCEDE
  DESCARTADA
}

model Usuario {
  id                  Int       @id @default(autoincrement())
  github_id           BigInt?   @unique
  github_login        String?   @unique
  nome                String
  papel               Papel
  matricula           String?   @unique
  senha_hash          String?
  senha_redefinida_em DateTime?
  aluno_teste         Boolean   @default(false)
  criado_em           DateTime  @default(now())

  emails            EmailCommit[]
  matriculas        Matricula[]
  equipe_membros    EquipeMembro[]
  equipes_lideradas Equipe[]             @relation("LiderEquipe")
  solicitacoes_equipe SolicitacaoEquipe[]
  repositorios      Repositorio[]
  revisoes          Sinalizacao[]  @relation("RevisorSinalizacao")
  commits           Commit[]
  avaliacoes_feitas Avaliacao[]    @relation("AvaliadorAvaliacao")

  @@map("usuarios")
}

model EmailCommit {
  id         Int     @id @default(autoincrement())
  usuario_id Int
  email      String  @unique
  verificado Boolean @default(false)

  usuario    Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("emails_commit")
}

model Disciplina {
  id     Int     @id @default(autoincrement())
  nome   String
  codigo String  @unique // ex.: ED-2026-2

  turmas Turma[]

  @@map("disciplinas")
}

model Turma {
  id            Int      @id @default(autoincrement())
  disciplina_id Int
  nome          String // ex.: Subturma A
  periodo       String // ex.: 2026.2

  disciplina    Disciplina @relation(fields: [disciplina_id], references: [id], onDelete: Cascade)
  matriculas    Matricula[]
  trabalhos     Trabalho[]

  @@map("turmas")
}

model Matricula {
  usuario_id Int
  turma_id   Int

  usuario    Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  turma      Turma   @relation(fields: [turma_id], references: [id], onDelete: Cascade)

  @@id([usuario_id, turma_id])
  @@map("matriculas")
}

model Trabalho {
  id                    Int          @id @default(autoincrement())
  turma_id              Int
  titulo                String
  descricao_md          String
  slug                  String       @unique
  tipo                  TipoTrabalho
  template_repo         String // owner/nome
  janela_inicio         DateTime
  deadline              DateTime
  congelamento_automatico Boolean     @default(true)
  min_integrantes_equipe  Int         @default(2)
  max_integrantes_equipe  Int         @default(4)
  criado_em             DateTime     @default(now())

  turma                 Turma        @relation(fields: [turma_id], references: [id], onDelete: Cascade)
  equipes               Equipe[]
  repositorios          Repositorio[]
  entregas              Entrega[]
  entregas_agendadas    EntregaAgendada[]

  @@map("trabalhos")
}

/**
 * Marco de entrega agendado: um trabalho pode ter N destes, além do `deadline`
 * único (que continua intocado — trava a janela do trabalho, D16). Cada marco
 * é um ponto de controle adicional (checkpoint, entrega parcial) com sua
 * própria data/hora; o congelador (`src/jobs/congelador.ts`) usa o commit que
 * era HEAD de `main` NAQUELA data (via GitHub `listCommits ... until`), não o
 * HEAD atual — é o que permite criar um marco retroativo e congelar
 * corretamente mesmo dias depois.
 */
model EntregaAgendada {
  id                      Int      @id @default(autoincrement())
  trabalho_id             Int
  nome                    String
  data_hora               DateTime
  congelamento_automatico Boolean  @default(true)
  criado_em               DateTime @default(now())

  trabalho                Trabalho  @relation(fields: [trabalho_id], references: [id], onDelete: Cascade)
  entregas                Entrega[]

  @@unique([trabalho_id, nome])
  @@index([trabalho_id, data_hora])
  @@map("entregas_agendadas")
}

model Equipe {
  id          Int      @id @default(autoincrement())
  trabalho_id Int
  nome        String
  formada_em  DateTime?
  lider_id    Int

  trabalho    Trabalho @relation(fields: [trabalho_id], references: [id], onDelete: Cascade)
  lider       Usuario  @relation("LiderEquipe", fields: [lider_id], references: [id])
  membros     EquipeMembro[]
  solicitacoes SolicitacaoEquipe[]
  repositorios Repositorio[]

  @@map("equipes")
}

model SolicitacaoEquipe {
  id          Int      @id @default(autoincrement())
  equipe_id   Int
  usuario_id  Int
  criada_em   DateTime @default(now())
  equipe      Equipe   @relation(fields: [equipe_id], references: [id], onDelete: Cascade)
  usuario     Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([equipe_id, usuario_id])
  @@map("solicitacoes_equipe")
}

model EquipeMembro {
  equipe_id  Int
  usuario_id Int

  equipe     Equipe  @relation(fields: [equipe_id], references: [id], onDelete: Cascade)
  usuario    Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@id([equipe_id, usuario_id])
  @@map("equipe_membros")
}

model Repositorio {
  id             Int      @id @default(autoincrement())
  trabalho_id    Int
  dono_tipo      DonoTipo
  usuario_id     Int?
  equipe_id      Int?
  github_repo_id BigInt   @unique
  nome_completo  String   // org/nome
  criado_em      DateTime @default(now())

  // Estado da sequência pós-criação (colaboradores + proteção de branch).
  // ERRO fica visível ao professor no dashboard quando os retries se esgotam.
  setup_status     RepoSetupStatus @default(PENDENTE)
  setup_erro       String?
  setup_tentativas Int             @default(0)

  trabalho       Trabalho  @relation(fields: [trabalho_id], references: [id], onDelete: Cascade)
  usuario        Usuario?  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  equipe         Equipe?   @relation(fields: [equipe_id], references: [id], onDelete: Cascade)
  pushes         Push[]
  commits        Commit[]
  entregas       Entrega[]
  sinalizacoes   Sinalizacao[]
  avaliacao      Avaliacao?

  @@map("repositorios")
}

model Push {
  id               Int      @id @default(autoincrement())
  repositorio_id   Int
  pusher_github_id BigInt
  pusher_login     String
  forced           Boolean  @default(false)
  recebido_em      DateTime @default(now())
  ref              String
  github_delivery_id String  @unique

  repositorio      Repositorio @relation(fields: [repositorio_id], references: [id], onDelete: Cascade)
  commits          Commit[]

  @@index([repositorio_id, recebido_em])
  @@map("pushes")
}

model Commit {
  id               Int      @id @default(autoincrement())
  push_id          Int
  repositorio_id   Int
  sha              String
  mensagem         String
  autor_nome       String
  autor_email      String
  autor_usuario_id Int?
  committed_em     DateTime
  additions        Int?
  deletions        Int?
  stats_status     StatsStatus @default(PENDENTE)

  push             Push        @relation(fields: [push_id], references: [id], onDelete: Cascade)
  repositorio      Repositorio @relation(fields: [repositorio_id], references: [id], onDelete: Cascade)
  autor_usuario    Usuario?    @relation(fields: [autor_usuario_id], references: [id], onDelete: SetNull)

  @@unique([repositorio_id, sha])
  @@index([repositorio_id, committed_em])
  @@map("commits")
}

model Entrega {
  id                  Int      @id @default(autoincrement())
  repositorio_id      Int
  trabalho_id         Int
  // Null = entrega do deadline único do trabalho (comportamento original).
  // Preenchido = entrega gerada por um EntregaAgendada (marco extra).
  entrega_agendada_id Int?
  sha_congelado       String
  tag                 String   // ex.: entrega-1
  congelado_em        DateTime @default(now())

  repositorio      Repositorio      @relation(fields: [repositorio_id], references: [id], onDelete: Cascade)
  trabalho         Trabalho         @relation(fields: [trabalho_id], references: [id], onDelete: Cascade)
  entrega_agendada EntregaAgendada? @relation(fields: [entrega_agendada_id], references: [id], onDelete: SetNull)

  @@map("entregas")
}

model Sinalizacao {
  id             Int                    @id @default(autoincrement())
  repositorio_id Int
  tipo           SinalizacaoTipo
  intensidade    SinalizacaoIntensidade
  evidencia_json Json
  status         SinalizacaoStatus      @default(PENDENTE)
  nota_revisao   String?
  revisado_por   Int?
  detectado_em   DateTime               @default(now())
  revisado_em    DateTime?

  repositorio    Repositorio @relation(fields: [repositorio_id], references: [id], onDelete: Cascade)
  revisor        Usuario?    @relation("RevisorSinalizacao", fields: [revisado_por], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("sinalizacoes")
}

/**
 * Nota e comentário lançados manualmente pelo professor sobre a entrega de um
 * repositório (aluno ou equipe). Uma linha por repositório — corrigir de novo
 * substitui a nota anterior, não acumula histórico. Nenhum detector ou métrica
 * escreve aqui: é decisão do professor, nunca cálculo automático (D-corretude
 * em docs/DECISOES.md).
 */
model Avaliacao {
  id             Int      @id @default(autoincrement())
  repositorio_id Int      @unique
  nota           Float?
  comentario     String?
  avaliado_por   Int
  criado_em      DateTime @default(now())
  atualizado_em  DateTime @updatedAt

  repositorio    Repositorio @relation(fields: [repositorio_id], references: [id], onDelete: Cascade)
  professor      Usuario     @relation("AvaliadorAvaliacao", fields: [avaliado_por], references: [id])

  @@map("avaliacoes")
}
